# Copy to config/secrets.local and fill in. secrets.local is git-ignored.
MA_TOKEN=
HA_TOKEN=
WIFI_SSID=
WIFI_PASSWORD=
# Where the dial finds things, read into the firmware at build time.
# CHANGE: your Home Assistant, Music Assistant and Denon addresses.
HA_SERVER=http://homeassistant.local:8123
MA_SERVER=http://homeassistant.local:8095
AMP_SERVER=http://192.168.1.50
# CHANGE: the Music Assistant player the dial plays to (Settings > Players,
# the player's id).
MA_PLAYER=
# Figma personal access token, scopes file_comments:read (+ :write to reply).
# Settings -> Security -> Personal access tokens. Used by tools/figma_comments.py.
FIGMA_TOKEN=

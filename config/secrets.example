# Copy to config/secrets.local and fill in. secrets.local is git-ignored.
MA_TOKEN=
HA_TOKEN=
WIFI_SSID=
WIFI_PASSWORD=
# Where the dial finds things, read into the firmware at build time.
# CHANGE: your Home Assistant and Music Assistant addresses.
HA_SERVER=http://homeassistant.local:8123
MA_SERVER=http://homeassistant.local:8095
# CHANGE: your Denon or Marantz receiver's address, or leave it blank if you
# have no amp. Blank, the dial acts as if an amp is connected: everything
# works on screen, and the volume and tone controls change nothing. You can
# also set it later, with no rebuild, in Home Assistant's
# input_text.<room>_dial_amp_address helper, which wins over this.
AMP_SERVER=
# CHANGE: the Music Assistant player the dial plays to (Settings > Players,
# the player's id), or leave it blank if you have no streamer yet. Blank, the
# dial says "No streamer" when it starts, then lets you browse everything,
# but nothing plays. You can also set it later, with no rebuild, in Home
# Assistant's input_text.<room>_dial_player helper, which wins over this.
MA_PLAYER=
# CHANGE: the room the dial is in, lower case with _ for spaces. Every helper
# and sensor is named from it: kitchen gives input_number.kitchen_amp_volume,
# input_boolean.kitchen_music, sensor.kitchen_dial_battery and so on.
DIAL_ROOM=your_room
# Figma personal access token, scopes file_comments:read (+ :write to reply).
# Settings -> Security -> Personal access tokens. Used by tools/figma_comments.py.
FIGMA_TOKEN=
